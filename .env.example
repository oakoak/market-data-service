# Copy this file to `.env` (docker-compose reads `.env` automatically) and adjust
# as needed. No secrets required -- Binance public WS/REST market data needs no API keys.

# --- Host port overrides (data-plane services only; useful if 6379/8123/9000/3100
# are already taken locally) ---
REDIS_HOST_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
LOKI_HOST_PORT=3100

# --- Single entry point: api/grafana/prometheus/cadvisor are only reachable
# through Traefik on this one port, routed by hostname (api.localhost,
# grafana.localhost, prometheus.localhost, cadvisor.localhost, plus Traefik's
# own dashboard at traefik.localhost). Override if 80 needs root/is taken. ---
TRAEFIK_HOST_PORT=80

# --- Grafana admin login (local dev only) ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Instrument selection ---
# SEGMENT=spot runs the Binance spot slice, now multi-symbol as of Phase A
# (docs/08-prototype-roadmap.md): the `collector` container multiplexes
# every symbol in SYMBOLS over one combined WS connection, and
# docker-compose.yml runs one `normalizer-<symbol>` container per symbol
# (each with its own order-book/incident state -- src/normalizer/consumer.py
# `NormalizerContext` is still scoped to a single symbol per process). The
# default below is the full 8-symbol spot instrument list from
# docs/04-architecture/exchanges/binance.md. To collect fewer symbols, list
# only those here -- but note docker-compose.yml's `normalizer-*` services
# are still static per-symbol blocks (see its header comment), so trimming
# SYMBOLS doesn't remove the now-idle matching normalizer container, and
# adding a symbol not in the default 8 needs a new `normalizer-*` block
# added there by hand.
#
# SEGMENT=usdtm runs the Phase B USDT-M perp slice (trades, L2 book,
# funding/mark/index price, open interest, liquidations) -- still
# single-symbol-per-process, NOT generalized to multi-symbol in Phase A
# (collector/main.py raises if SYMBOLS lists more than one symbol under
# usdtm). Running spot's multi-symbol setup and a usdtm slice at the same
# time means duplicating the collector/normalizer services in
# docker-compose.yml with distinct env blocks (still not done here -- same
# limitation as before Phase A, just narrower in scope now).
EXCHANGE=binance
SEGMENT=spot
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,BTCFDUSD,ETHFDUSD
# For SEGMENT=usdtm, set SYMBOLS to exactly one symbol instead, e.g.:
# SYMBOLS=BTCUSDT

# --- Redis Streams (broker DB, separate from any future cache DB) ---
REDIS_STREAM_DB=1
REDIS_STREAM_MAXLEN=1000000

# --- Collector reconnect backoff ---
BACKOFF_INITIAL_S=1
BACKOFF_MAX_S=60

# --- ClickHouse ---
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=market_data

# --- Logging ---
LOG_LEVEL=INFO
